# Copy to .env and fill in. Never commit real .env.

# Required: long random string used to encrypt cookies/tokens at rest
PANBRIDGE_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Web UI admin password
ADMIN_PASSWORD=change-me-strong-password

HOST=0.0.0.0
PORT=8080

# Absolute path recommended on VPS
DATA_DIR=./data

# Small VPS (Oracle free tier 1GB RAM): keep 1
MAX_CONCURRENT_JOBS=1

DOWNLOAD_CHUNK_SIZE=1048576
# Parallel Range connections (Quark / generic). Auto-fallback if CDN rejects.
DOWNLOAD_CONNECTIONS=6
# Baidu: try multi (LogStatistic); falls back to 1 on 403
BAIDU_DOWNLOAD_CONNECTIONS=4

# Optional but recommended behind a reverse proxy. Used to build VLC/IINA links.
# PUBLIC_BASE_URL=https://panbridge.example.com
# Signed external-player links expire after this many seconds (default: 7 days).
STREAM_TOKEN_MAX_AGE=604800

# pCloud: eapi.pcloud.com = EU, api.pcloud.com = US
PCLOUD_API_HOST=eapi.pcloud.com
PCLOUD_DEFAULT_PATH=/PanBridge
